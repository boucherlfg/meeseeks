<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Meeseeks</RootNamespace>
		<AssemblyName>Meeseeks</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TieredPGO>true</TieredPGO>
		<Version>0.1.0</Version>
		<Description>A coding-agent harness written in C#, with one general-purpose tool: a C# code runner.</Description>
		<RepositoryUrl>https://github.com/boucherlfg/meeseeks</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
	</ItemGroup>

</Project>
